{
  "name": "IPAForge",
  "short_name": "IPAForge",
  "description": "Install SideStore and your own apps onto iPhone and iPad from Windows, macOS and Linux.",
  "start_url": "/",
  "display": "browser",
  "background_color": "#0b0c19",
